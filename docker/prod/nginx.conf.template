# Hôte virtuel du reverse proxy de la machine (rendu par docker/prod/setup-host.sh ; __DOMAIN__, __PORT__ et __PROXY_TIMEOUT__ y sont remplacés).
# Certbot y ajoute ensuite le TLS et la redirection HTTP -> HTTPS.
server {
    server_name __DOMAIN__;
    listen 80;

    client_max_body_size 2m;
    add_header Strict-Transport-Security "max-age=31536000" always;

    location / {
        proxy_pass         http://127.0.0.1:__PORT__;
        proxy_http_version 1.1;
        proxy_set_header   Host $host;
        proxy_set_header   X-Real-IP $remote_addr;
        proxy_set_header   X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        # Une requête SQL peut durer jusqu'à son délai maximal. La valeur vient de TERRILDB_PROXY_TIMEOUT (deploy.env) ; l'application
        # la relit dans l'en-tête ci-dessous pour en tirer la limite de durée des requêtes et signaler un désaccord (ProxyTimeoutListener).
        proxy_read_timeout __PROXY_TIMEOUT__s;
        proxy_set_header   X-TerrilDB-Proxy-Timeout __PROXY_TIMEOUT__;
    }
}
